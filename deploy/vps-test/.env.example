# Settings of the test stand only. This file is read by this stand and by nothing else on the host.
# Copy to .env and fill in: cp .env.example .env && chmod 600 .env

# API token, 24+ characters: openssl rand -hex 24
MIH_API_TOKEN=

# Where the port is published on the host. 127.0.0.1 = only from the server itself (SSH tunnel).
# For access over Tailscale put the host's Tailscale address here (tailscale ip -4), e.g. 100.x.y.z.
MIH_PUBLISH_ADDR=127.0.0.1
MIH_PUBLISH_PORT=18765
# MCP server for an AI agent on this host: always published on 127.0.0.1 only.
MIH_MCP_PUBLISH_PORT=18766
# Its own token (24+ characters); empty = MIH_API_TOKEN. Daily cap on tool calls, 0 = none.
MIH_MCP_TOKEN=
MIH_MCP_DAILY_LIMIT=0
# "На ТВ" in the web UI: agent = the command waits for the agent (MCP tool queue), off = none.
MIH_PLAYBACK=agent
# Optional: URL the server POSTs to when a command waits, and its bearer token.
MIH_AGENT_WEBHOOK=
MIH_AGENT_WEBHOOK_TOKEN=

# Resource limits of the container.
MIH_MEM_LIMIT=512m
MIH_CPUS=1.0

# IANA time zone for "today/tomorrow/evening" in search, e.g. Europe/Berlin.
MIH_TIMEZONE=UTC

# Language of pushes and of the event feed: en or ru.
MIH_LANG=en

# Push notifications through ntfy. Install the ntfy app, subscribe to a long random topic
# (it works as a password) and put its URL here: https://ntfy.sh/<topic>. Empty = no pushes.
MIH_NTFY_URL=
# Lowest level that is pushed: info, warning or error.
MIH_NOTIFY_LEVEL=info

# Built-in scheduler: how often to refresh playlists and the guide from their URLs and check
# streams (30m, 6h, 1d, off), and the local time of the daily summary (HH:MM or off).
MIH_EVERY_SOURCES=6h
MIH_EVERY_EPG=12h
MIH_EVERY_HEALTH=10m
MIH_DIGEST_AT=09:00
# Topic alerts: scan every 5 min, push 15 min before a programme on a followed topic.
# MIH_ALERT_LINK=auto opens the stream itself while MIH_PUBLIC_URL is not set.
MIH_EVERY_ALERTS=5m
MIH_ALERT_LEAD=15m
MIH_ALERT_LINK=auto

# Playlist discovery (docs/discovery.md): the scout looks for public playlists, the packer
# checks their streams in small batches and imports the ones that play.
MIH_EVERY_DISCOVER=5m
# New search pass: auto = daily for the first 60 days, then monthly.
MIH_DISCOVERY_SEARCH_EVERY=auto
MIH_EVERY_PACK=15m
# Optional: any GitHub token without scopes enables code search and a higher API limit.
MIH_GITHUB_TOKEN=
# Optional: extra pages, Telegram channels and blocked hosts, e.g. /data/discovery.json.
MIH_DISCOVERY_FILE=
# Optional: the country the TVs are in (e.g. vn). Its channels a geo block hides from this
# server are still imported, for a TV at home to confirm.
MIH_HOME_COUNTRY=

# Google Drive (docs/drive.md): channels.json and channels.csv, no stream URLs, uploaded
# every MIH_EVERY_DRIVE when the channels changed. MIH_DRIVE_TOKEN is the one-line JSON that
# `rclone authorize "drive"` prints on your own computer; the folder ID is the last part of
# the folder's address in the browser. Empty token = no upload.
MIH_DRIVE_TOKEN=
MIH_DRIVE_FOLDER_ID=
MIH_EVERY_DRIVE=6h

# How many backup archives to keep in backups/ (the pre-upgrade one is always kept).
MIH_BACKUP_KEEP=5
